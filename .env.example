# Supabase (add values when connecting the backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP - configure only on the server.
# These values must come from your SMTP/email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Server-generated secrets - create unique values; do not commit real values here.
# Generate each independently with: openssl rand -hex 32
# Add the generated values to your local .env.local or Render Environment settings.
CRON_SECRET=
RATE_LIMIT_HASH_SECRET=
SMTP_ENCRYPTION_KEY=
# IMPORTANT: Keep SMTP_ENCRYPTION_KEY stable. Changing it can make previously
# encrypted SMTP credentials impossible to decrypt.

# Payments - server-side secrets only
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
